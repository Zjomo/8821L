implementation
// define the Dll functions
type
 //Communications
 TARC_Search_For_Filter        = function (out Num_Found : integer): wordbool; stdcall;
 TARC_Open_Filter              = function (Enum_Num : integer; out Filter_Enum : integer): wordbool; stdcall;
 TARC_Open_Filter_Port         = function ( Com_Num : integer; out Filter_Enum : integer): wordbool; stdcall;
 TARC_Close_Filter             = function (Filter_Enum : integer): wordbool; stdcall;
 TARC_Valid_Filter_Enum        = function (Filter_Enum : integer): wordbool; stdcall;
 TARC_get_Filter_preOpen_Model = function (Enum_Num : integer; out Model_Var : olevariant) : wordbool; stdcall;
 TARC_Ver                    = function (out Major : integer; out Minor : integer; out Build : integer) : wordbool; stdcall;
 // direct communications function
 TARC_Send_CMD_To_Filter       = function (Filter_Enum : integer; SendCMD : olevariant; out RCV_Var : olevariant; ms_Timeout : integer) : wordbool; stdcall;

 //Information
 TARC_get_Filter_Model         = function (Filter_Enum : integer;out Model_Var : olevariant): wordbool; stdcall;
 TARC_get_Filter_Serial        = function (Filter_Enum : integer;out Serial_Var : olevariant): wordbool; stdcall;

 //Filter
 TARC_get_Filter_Present  = function (Filter_Enum : integer): wordbool; stdcall;
 TARC_get_Filter_Position = function (Filter_Enum : integer; out Position : integer): wordbool; stdcall;
 TARC_set_Filter_Position = function (Filter_Enum : integer; Position : integer): wordbool; stdcall;
 TARC_get_Filter_Min_Pos  = function (Filter_Enum : integer; out Position : integer): wordbool; stdcall;
 TARC_get_Filter_Max_Pos  = function (Filter_Enum : integer; out Position : integer): wordbool; stdcall;
 TARC_Filter_Home         = function (Filter_Enum : integer): wordbool; stdcall;
 TARC_Filter_Init         = function (Filter_Enum : integer): wordbool; stdcall;

// Local functions
var
 //Communications
 Local_ARC_Search_For_Filter        : TARC_Search_For_Filter;
 Local_ARC_Open_Filter              : TARC_Open_Filter;
 Local_ARC_Open_Filter_Port         : TARC_Open_Filter_Port;
 Local_ARC_Close_Filter             : TARC_Close_Filter;
 Local_ARC_Valid_Filter_Enum        : TARC_Valid_Filter_Enum;
 Local_ARC_get_Filter_preOpen_Model : TARC_get_Filter_preOpen_Model;
 Local_ARC_Ver                    : TARC_Ver;
 // direct communications function
 Local_ARC_Send_CMD_To_Filter       : TARC_Send_CMD_To_Filter;

 //Information
 Local_ARC_get_Filter_Model         : TARC_get_Filter_Model;
 Local_ARC_get_Filter_Serial        : TARC_get_Filter_Serial;

 //Filter
 Local_ARC_get_Filter_Present  : TARC_get_Filter_Present;
 Local_ARC_get_Filter_Position : TARC_get_Filter_Position;
 Local_ARC_set_Filter_Position : TARC_set_Filter_Position;
 Local_ARC_get_Filter_Min_Pos  : TARC_get_Filter_Min_Pos;
 Local_ARC_get_Filter_Max_Pos  : TARC_get_Filter_Max_Pos;
 Local_ARC_Filter_Home         : TARC_Filter_Home;

// ARC_FilterWheel.dll encapsulation handle
ARC_FilterWheel : THandle;

// dynamic load and unload functions functions
function Dynamic_Load_ARC_FilterWheel_DLL : boolean;
begin
ARC_FilterWheel := 0;
try
ARC_FilterWheel := LoadLibrary ('ARC_FilterWheel.dll');
if ARC_FilterWheel <> 0
then begin
     //Communications
     @Local_ARC_Search_For_Filter := GetProcAddress (ARC_FilterWheel, 'ARC_Search_For_Filter');
     @Local_ARC_Open_Filter := GetProcAddress (ARC_FilterWheel, 'ARC_Open_Filter');
     @Local_ARC_Open_Filter_Port := GetProcAddress (ARC_FilterWheel, 'ARC_Open_Filter_Port');
     @Local_ARC_Close_Filter := GetProcAddress (ARC_FilterWheel, 'ARC_Close_Filter');
     @Local_ARC_Valid_Filter_Enum := GetProcAddress (ARC_FilterWheel, 'ARC_Valid_Filter_Enum');
     @Local_ARC_get_Filter_preOpen_Model := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_preOpen_Model');
     @Local_ARC_Ver := GetProcAddress (ARC_FilterWheel, 'ARC_Ver');
     // direct communications function
     @Local_ARC_Send_CMD_To_Filter := GetProcAddress (ARC_FilterWheel, 'ARC_Send_CMD_To_Filter');

     //Information
     @Local_ARC_get_Filter_Model := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Model');
     @Local_ARC_get_Filter_Serial := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Serial');

     //Filter
     @Local_ARC_get_Filter_Present := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Present');
     @Local_ARC_get_Filter_Position := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Position');
     @Local_ARC_set_Filter_Position := GetProcAddress (ARC_FilterWheel, 'ARC_set_Filter_Position');
     @Local_ARC_get_Filter_Min_Pos := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Min_Pos');
     @Local_ARC_get_Filter_Max_Pos := GetProcAddress (ARC_FilterWheel, 'ARC_get_Filter_Max_Pos');
     @Local_ARC_Filter_Home := GetProcAddress (ARC_FilterWheel, 'ARC_Filter_Home');

     // verify we properly linked the functions from the DLL
     if //Communications
        (@Local_ARC_Search_For_Filter <> nil)
        and
        (@Local_ARC_Open_Filter <> nil)
         and
        (@Local_ARC_Open_Filter_Port <> nil)
         and
        (@Local_ARC_Close_Filter <> nil)
         and
        (@Local_ARC_Valid_Filter_Enum <> nil)
         and
        (@Local_ARC_get_Filter_preOpen_Model <> nil)
         and
        (@Local_ARC_Ver <> nil)
         and
        // direct communications function
        (@Local_ARC_Send_CMD_To_Filter <> nil)
         and
        //Information
        (@Local_ARC_get_Filter_Model <> nil)
         and
        (@Local_ARC_get_Filter_Serial <> nil)
         and
        //Filter
        (@Local_ARC_get_Filter_Present <> nil)
         and
        (@Local_ARC_get_Filter_Position <> nil)
         and
        (@Local_ARC_set_Filter_Position <> nil)
         and
        (@Local_ARC_get_Filter_Min_Pos <> nil)
         and
        (@Local_ARC_get_Filter_Max_Pos <> nil)
         and
        (@Local_ARC_Filter_Home <> nil)
     then begin
          // dynamically loaded ARC_FilterWheel.dll
          result := true;
          end
     else begin
          FreeLibrary ( ARC_FilterWheel );
          ARC_FilterWheel := 0;
          result := false;
          end;
     end
else begin
     result := false;
     end;
except
  result := false;
  end;
end;

procedure unload_ARC_FilterWheel_DLL;
//var
//CloseLoop : integer;
begin
// Delphi 6 unloads the library on exit and
// blows exeptions if you unload it for it
// so the unload library is commented out
{
if ARC_SpectraPro <> 0
then begin
     // force closed any open port
     for CloseLoop := 0 to 15
      do ARC_Close_Filter(CloseLoop);
     // unload the library
     FreeLibrary ( ARC_SpectraPro );
     ARC_SpectraPro := 0;
     end;
}
end;

//Communications
function ARC_Search_For_Filter(out Num_Found : integer): wordbool;
begin
result := Local_ARC_Search_For_Filter(Num_Found);
end;
function ARC_Open_Filter(Enum_Num : integer; out Filter_Enum : integer): wordbool;
begin
result := Local_ARC_Open_Filter(Enum_Num,Filter_Enum);
end;
function ARC_Open_Filter_Port(Com_Num : integer; out Filter_Enum : integer) : wordbool;
begin
result := Local_ARC_Open_Filter_Port(Com_Num,Filter_Enum);
end;
function ARC_Close_Filter(Filter_Enum : integer): wordbool;
begin
result := Local_ARC_Close_Filter(Filter_Enum);
end;
function ARC_Valid_Filter_Enum(Filter_Enum : integer): wordbool;
begin
result := Local_ARC_Valid_Filter_Enum(Filter_Enum);
end;
function ARC_get_Filter_preOpen_Model(Enum_Num : integer; out Model_str : string) : wordbool;
var
Model_Var : olevariant;
begin
result := Local_ARC_get_Filter_preOpen_Model(Enum_Num,Model_Var);
Model_Str := string(Model_Var);
end;
function ARC_Ver(out Major : integer; out Minor : integer; out Build : integer) : wordbool;
begin
result := Local_ARC_Ver(Major,Minor,Build);
end;
// direct communications function
function ARC_Send_CMD_To_Filter(Filter_Enum : integer; SendCMD : string; out RCV_str : string; ms_Timeout : integer) : wordbool;
var
Send_Var,RCV_Var : olevariant;
begin
Send_Var := SendCMD;
result := local_ARC_Send_CMD_To_Filter(Filter_Enum,Send_Var,RCV_Var,ms_Timeout);
RCV_Str := RCV_Var;
end;

//Information
function ARC_get_Filter_Model(Filter_Enum : integer;out Model_str : string): wordbool;
var
Model_var : olevariant;
begin
result := local_ARC_get_Filter_Model(Filter_Enum,Model_Var);
Model_Str := string(Model_Var);
end;
function ARC_get_Filter_Serial(Filter_Enum : integer;out Serial_str : string): wordbool;
var
Serial_var : olevariant;
begin
result := local_ARC_get_Filter_Serial(Filter_Enum,Serial_var);
Serial_str := string(Serial_var);
end;
//Filter
function ARC_get_Filter_Present(Filter_Enum : integer): wordbool;
begin
result := local_ARC_get_Filter_Present(Filter_Enum);
end;
function ARC_get_Filter_Position(Filter_Enum : integer; out Position : integer): wordbool;
begin
result := local_ARC_get_Filter_Position(Filter_Enum,Position);
end;
function ARC_set_Filter_Position(Filter_Enum : integer; Position : integer): wordbool;
begin
result := local_ARC_set_Filter_Position(Filter_Enum,Position);
end;
function ARC_get_Filter_Min_Pos(Filter_Enum : integer; out Position : integer): wordbool;
begin
result := local_ARC_get_Filter_Min_Pos(Filter_Enum,Position);
end;
function ARC_get_Filter_Max_Pos(Filter_Enum : integer; out Position : integer): wordbool;
begin
result := local_ARC_get_Filter_Max_Pos(Filter_Enum,Position);
end;
function ARC_Filter_Home(Filter_Enum : integer): wordbool;  
begin
result := local_ARC_Filter_Home(Filter_Enum);
end;

end.

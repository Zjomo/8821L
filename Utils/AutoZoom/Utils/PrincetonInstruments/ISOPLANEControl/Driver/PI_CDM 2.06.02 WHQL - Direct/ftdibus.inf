%USB\VID_0647&PID_0201.DeviceDesc%=FtdiBus.NT,USB\VID_0647&PID_0201
%USB\VID_0647&PID_0202.DeviceDesc%=FtdiBus.NT,USB\VID_0647&PID_0202
%USB\VID_0647&PID_0203.DeviceDesc%=FtdiBus.NT,USB\VID_0647&PID_0203

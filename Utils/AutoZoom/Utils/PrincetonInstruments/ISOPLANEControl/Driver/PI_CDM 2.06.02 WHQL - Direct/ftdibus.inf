%USB\VID_0647&PID_0250.DeviceDesc%=FtdiBus.NT,USB\VID_0647&PID_0250

[FtdiHw.NTamd64]
%USB\VID_0647&PID_03E9.DeviceDesc%=FtdiBus.NTamd64, USB\VID_0647&PID_03E9
%USB\VID_0647&PID_03EA.DeviceDesc%=FtdiBus.NTamd64, USB\VID_0647&PID_03EA
%USB\VID_0647&PID_03EB.DeviceDesc%=FtdiBus.NTamd64, USB\VID_0647&PID_03EB
%USB\VID_0647&PID_03EC.DeviceDesc%=FtdiBus.NTamd64, USB\VID_0647&PID_03EC
%USB\VID_0647&PID_0200.DeviceDesc%=FtdiBus.NTamd64,USB\VID_0647&PID_0200
%USB\VID_0647&PID_0201.DeviceDesc%=FtdiBus.NTamd64,USB\VID_0647&PID_0201
%USB\VID_0647&PID_0202.DeviceDesc%=FtdiBus.NTamd64,USB\VID_0647&PID_0202
%USB\VID_0647&PID_0203.DeviceDesc%=FtdiBus.NTamd64,USB\VID_0647&PID_0203
%USB\VID_0647&PID_0204.DeviceDesc%=FtdiBus.NTamd64,USB\VID_0647&PID_0204
